</asp:Content>
<asp:Content ID="ReportBody" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div id="dashboard-report-shell" class="dr-report ur-shell" ng-class="{'dr-loading-groups':vm.loading}" ng-app="pmsDashboardReportApp" ng-controller="ReportController as vm" ng-cloak>
<div class="dr-back"><a href="../dashboard/">Back to Dashboard</a></div>
<section class="ur-card dr-filter-sticky"><div class="dr-filters">
<label ng-hide="true">Report<select ng-model="vm.f.reportType" ng-options="t.id as t.name for t in vm.types" ng-change="vm.changeType()"></select></label>
<label>Date Range<select ng-model="vm.preset" ng-options="p for p in vm.presets" ng-change="vm.preset !== 'Custom' && vm.changeDates()"></select></label>
<label ng-if="vm.preset==='Custom'">From<input type="date" onclick="if(this.showPicker){try{this.showPicker();}catch(e){}}" ng-model="vm.from" ng-change="vm.from && vm.to && vm.changeDates()" /></label>
<label ng-if="vm.preset==='Custom'">To<input type="date" onclick="if(this.showPicker){try{this.showPicker();}catch(e){}}" ng-model="vm.to" ng-change="vm.from && vm.to && vm.changeDates()" /></label>
<label ng-if="vm.f.reportType==='issues'">Group By<select ng-model="vm.f.issueState" ng-change="vm.changed()"><option value="All">All</option><option value="Completed">Complete</option><option value="Pending">Not Complete</option></select></label>
<div class="dr-project-field"><label for="dr-project-search">Project</label><input id="dr-project-search" type="text" role="combobox" autocomplete="off" aria-autocomplete="list" aria-controls="dr-project-options" aria-expanded="{{vm.projectOpen}}" aria-activedescendant="{{vm.projectOpen && vm.projectMatches().length ? 'dr-project-option-'+vm.projectIndex : ''}}" ng-model="vm.projectText" ng-focus="vm.projectFocus()" ng-change="vm.projectSearch()" ng-keydown="vm.projectKey($event)" ng-blur="vm.projectBlur()" placeholder="Search projects..." /><div id="dr-project-options" class="dr-project-options" role="listbox" ng-if="vm.projectOpen"><div ng-repeat="p in vm.projectMatches() track by p.id" id="dr-project-option-{{$index}}" role="option" aria-selected="{{vm.projectIndex===$index}}" ng-class="{'active':vm.projectIndex===$index}" ng-mousedown="$event.preventDefault();vm.projectPick(p)">{{p.ProjectName}}</div><div ng-if="!vm.projectMatches().length">No projects found</div></div></div>
<label ng-if="vm.f.reportType!=='issues'">Group By<select ng-model="vm.f.groupBy" ng-options="g for g in (vm.f.reportType === 'issues' ? ['Complete / Not Complete'] : ((vm.f.groupBy === 'Status' || vm.f.groupBy === 'Priority') ? ['Status','Priority'] : [vm.f.groupBy,'Status','Priority']))" ng-change="vm.changed()"></select></label>
<label>Status<select ng-model="vm.f.statusId" ng-options="s.id as s.Name for s in vm.look.statuses" ng-change="vm.changed()"></select></label>
<label>Priority<select ng-model="vm.f.priorityId" ng-options="s.id as s.Name for s in vm.look.priorities" ng-change="vm.changed()"></select></label>
<label>Situation<select ng-model="vm.f.situationId" ng-options="s.id as s.Name for s in vm.look.situations" ng-change="vm.changed()"></select></label>
<div class="dr-project-field"><label for="dr-employee-search">Employee</label><input id="dr-employee-search" type="text" role="combobox" autocomplete="off" aria-autocomplete="list" aria-controls="dr-employee-options" aria-expanded="{{vm.employeeOpen}}" aria-activedescendant="{{vm.employeeOpen && vm.employeeMatches().length ? 'dr-employee-option-'+vm.employeeIndex : ''}}" ng-model="vm.employeeText" ng-focus="vm.employeeFocus()" ng-change="vm.employeeSearch()" ng-keydown="vm.employeeKey($event)" ng-blur="vm.employeeBlur()" placeholder="Search employees..." /><div id="dr-employee-options" class="dr-project-options dr-employee-options" role="listbox" ng-if="vm.employeeOpen"><div ng-repeat="p in vm.employeeMatches() track by p.id" id="dr-employee-option-{{$index}}" role="option" aria-selected="{{vm.employeeIndex===$index}}" ng-class="{'active':vm.employeeIndex===$index}" ng-mousedown="$event.preventDefault();vm.employeePick(p)">{{p.DisplayName}}</div><div ng-if="!vm.employeeMatches().length">No employees found</div></div></div>
<label ng-if="vm.f.reportType==='tags'">Tag<select ng-model="vm.f.tagId" ng-options="s.id as s.Name for s in vm.look.tags" ng-change="vm.changed()"></select></label>
<div class="ur-filter-actions"><div class="ur-filter-title">{{vm.title()}}</div><div class="ur-filter-action-buttons"><button type="button" class="ur-button secondary" ng-click="vm.clear()">Clear Filters</button><button type="button" class="ur-button secondary ur-export-button" ng-click="vm.exportExcel()" ng-disabled="vm.loading || vm.detailLoading || vm.exporting || !vm.total" aria-label="Export to Excel" title="Export to Excel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2.75h8l4.25 4.3v13.2H6z" fill="#eaf6ee" stroke="#16834b" stroke-width="1.5"/><path d="M14 2.75v4.5h4.25" fill="none" stroke="#16834b" stroke-width="1.5"/><path d="m9 11 4 6m0-6-4 6" fill="none" stroke="#16834b" stroke-width="1.8"/></svg></button></div><span role="status" ng-if="vm.exporting">Exporting...</span></div></div></section>
<div role="alert" class="ur-error" ng-if="vm.error || vm.exportError">{{vm.error || vm.exportError}}</div>
<div role="status" aria-label="Loading report groups" class="dr-group-loading" ng-if="vm.loading"><span class="dr-reference-spinner" aria-hidden="true"></span></div>
<section class="ur-card" ng-if="!vm.loading && !vm.error"><h2>Grouped by {{vm.f.groupBy}}</h2><div class="ur-table-wrap"><table class="ur-table"><thead><tr><th>Group</th><th>Count</th></tr></thead><tbody><tr ng-repeat="g in vm.groupRows() track by g.GroupKey" ng-class="{'dr-selected-group':vm.selected && vm.selected.GroupKey===g.GroupKey}"><td><button type="button" class="ur-group-button" ng-click="vm.open(g)" aria-pressed="{{!!vm.selected && vm.selected.GroupKey===g.GroupKey}}">{{g.GroupName}}</button></td><td>{{g.Count}}</td></tr><tr ng-if="!vm.groups.length"><td colspan="2" class="ur-empty">No records match these filters.</td></tr></tbody><tfoot><tr><th>Total</th><th>{{vm.total}}</th></tr></tfoot></table></div><div class="ur-grid-footer" ng-if="vm.groups.length"><label>Rows <select ng-model="vm.groupSize" ng-options="n for n in [5,10,20,50]" ng-change="vm.groupPage=1"></select></label><span class="ur-muted">Showing {{(vm.groupPage-1)*vm.groupSize+1}}&ndash;{{vm.groupPage*vm.groupSize > vm.groups.length ? vm.groups.length : vm.groupPage*vm.groupSize}} of {{vm.groups.length}} groups</span><div class="ur-pager"><button type="button" ng-click="vm.groupGo(vm.groupPage-1)" ng-disabled="vm.groupPage<=1">Previous</button><span>Page {{vm.groupPage}} / {{vm.groupPages()}}</span><button type="button" ng-click="vm.groupGo(vm.groupPage+1)" ng-disabled="vm.groupPage>=vm.groupPages()">Next</button></div></div></section>
<section class="ur-card" ng-if="vm.selected"><div class="dr-actions"><h2>{{vm.selected.GroupName}} &mdash; Details</h2><button type="button" class="ur-button secondary" ng-click="vm.back()">Back to Groups</button><div class="dr-detail-search input-group" role="search"><span class="input-group-text dr-search-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></span><input class="form-control" type="search" ng-model="vm.detailSearchText" ng-change="vm.detailSearchChanged()" ng-keydown="vm.detailSearchKey($event)" ng-blur="vm.applyDetailSearch()" placeholder="Search details..." aria-label="Search group details" /><button type="button" class="btn btn-outline-secondary dr-search-clear" ng-click="vm.detailSearchText='';vm.applyDetailSearch()" ng-disabled="!vm.detailSearchText && !vm.detailSearch" title="Clear search" aria-label="Clear detail search">&times;</button></div></div><div class="ur-error" ng-if="vm.detailError">{{vm.detailError}}</div>
<div class="dr-grid-loading-area"><div role="status" aria-label="Loading details" class="dr-grid-loading-overlay" ng-if="vm.detailLoading"><span class="dr-reference-spinner" aria-hidden="true"></span></div><div id="dr-details-grid" class="ur-table-wrap" aria-busy="{{vm.detailLoading}}"><table class="ur-table"><thead><tr><th>#</th><th>Project Name</th><th class="dr-name-column">Name</th><th class="dr-description-column">Description</th><th>Status</th><th>Priority</th><th>Situation</th><th>Completion</th><th ng-if="vm.f.reportType==='milestoneprogress'">Total Tasks</th><th ng-if="vm.f.reportType==='milestoneprogress'">Completed Tasks</th><th>Owner</th><th class="dr-team-column">Team</th><th>Start Date</th><th>End Date</th></tr></thead><tbody><tr ng-repeat="r in vm.rows track by $index"><td>{{r.RowNumber}}</td><td>{{r.ProjectName}}</td><td class="dr-name-column"><span dr-team-tooltip="{{r.Name}}" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-trigger="hover">{{r.Name | limitTo:30}}<span ng-if="r.Name.length>30">&hellip;</span></span></td><td class="wrap dr-description-column"><span dr-team-tooltip="{{r.Description}}" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-trigger="hover">{{r.Description | limitTo:40}}<span ng-if="r.Description.length>40">&hellip;</span></span></td><td>{{r.StatusName}}</td><td>{{r.PriorityName}}</td><td>{{r.SituationName}}</td><td>{{r.Completion | number:1}}%</td><td ng-if="vm.f.reportType==='milestoneprogress'">{{r.TotalTasks}}</td><td ng-if="vm.f.reportType==='milestoneprogress'">{{r.CompletedTasks}}</td><td>{{r.OwnerName}}</td><td class="dr-team-column"><div class="dr-team-avatars"><span class="dr-team-avatar" ng-repeat="member in vm.teamMembers(r) | limitTo:3 track by member.id" dr-team-tooltip="{{member.DisplayName}}" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-trigger="hover">{{vm.teamInitials(member.DisplayName)}}</span><span class="dr-team-more" ng-if="vm.teamMembers(r).length>3" dr-team-tooltip="{{vm.teamNames(r)}}" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-trigger="hover">+{{vm.teamMembers(r).length-3}}</span><span ng-if="!vm.teamMembers(r).length">&mdash;</span></div></td><td>{{r.StartDate}}</td><td>{{r.EndDate}}</td></tr><tr ng-if="!vm.rows.length"><td colspan="14" class="ur-empty">No details found.</td></tr></tbody></table></div></div>
<div class="ur-grid-footer"><label>Rows <select ng-model="vm.size" ng-options="n for n in [10,20,50,100]" ng-change="vm.page=1;vm.details()"></select></label><span>{{vm.detailTotal}} records</span><div class="ur-pager"><button type="button" ng-click="vm.go(vm.page-1)" ng-disabled="vm.page<=1 || vm.detailLoading">Previous</button><span>Page {{vm.page}} / {{vm.pages || 1}}</span><button type="button" ng-click="vm.go(vm.page+1)" ng-disabled="vm.page>=vm.pages || vm.detailLoading">Next</button></div></div>
</section></div></asp:Content>
