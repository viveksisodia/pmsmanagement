        .ur-hours-table th:nth-last-child(-n+2){text-align:right;vertical-align:middle;font-variant-numeric:tabular-nums;padding-right:12px}
    
.dr-report{padding:20px}.dr-filters{display:flex;flex-wrap:wrap;gap:12px}.dr-filters label{display:flex;flex-direction:column;gap:4px;font-size:12px}.dr-filters select,.dr-filters input{min-width:140px;padding:7px;border:1px solid #ccd5dd;border-radius:4px}.dr-report button{cursor:pointer}.dr-actions{display:flex;gap:10px;align-items:center;margin:14px 0}.dr-report th{white-space:nowrap}.dr-report [ng-cloak]{display:none}.dr-report .wrap{white-space:normal;min-width:160px}.dr-filters{align-items:flex-end}.dr-filters label{font-size:10px}.dr-filters select,.dr-filters input{min-width:118px;height:30px;padding:4px 7px;font-size:11px}.dr-filters .ur-filter-actions{margin-left:auto;align-self:center;flex-shrink:0}.dr-back{margin-bottom:8px;text-align:right;font-size:11px}@media(max-width:700px){.dr-filters .ur-filter-actions{width:100%;align-items:flex-end}}
.dr-filters>label,.dr-filters .dr-project-field>label{margin:0;line-height:14px;font-size:10px;font-weight:400}
.dr-filters>label,.dr-filters .dr-project-field{gap:4px;flex-shrink:0}
.dr-filters select,.dr-filters input{box-sizing:border-box;height:30px;margin:0;vertical-align:middle}
.dr-filters .ur-filter-actions{align-self:flex-end;gap:4px}
.dr-filters .ur-filter-title{line-height:14px}

.dr-filters input[type="date"]{position:relative;cursor:pointer}
.dr-filters input[type="date"]::-webkit-calendar-picker-indicator{position:absolute;inset:0;width:100%;height:100%;margin:0;padding:0;opacity:0;cursor:pointer}

#dashboard-report-shell{overflow:auto;box-sizing:border-box;position:relative}.dr-filter-sticky{position:sticky;top:0;z-index:1100;background:#fff;box-shadow:0 2px 4px #0001}

#dashboard-report-shell{isolation:isolate;z-index:1;background:#f1f5f7}.dr-actions{flex-wrap:wrap}.dr-detail-search{margin-left:auto;display:flex;flex-direction:column;gap:4px;font-size:10px}.dr-detail-search input{height:30px;width:240px;box-sizing:border-box;border:1px solid #d7dce2;border-radius:4px;padding:4px 7px;font-size:11px}

.dr-actions .dr-detail-search{margin-left:auto;display:flex;flex-direction:row;align-items:stretch;gap:0;width:280px;max-width:100%;flex-wrap:nowrap}
.dr-detail-search .dr-search-icon{display:flex;align-items:center;justify-content:center;width:32px;padding:0;border:1px solid #ced4da;border-right:0;border-radius:4px 0 0 4px;background:#f8f9fa;color:#6c757d}
.dr-detail-search input.form-control{flex:1;min-width:0;width:auto;height:32px;border:1px solid #ced4da;border-radius:0;margin:0;font-size:12px;box-shadow:none}
.dr-detail-search input.form-control:focus{outline:0;border-color:#9c80c8;box-shadow:inset 0 0 0 1px #9c80c8}
.dr-detail-search .dr-search-clear{width:32px;height:32px;padding:0;border:1px solid #ced4da;border-left:0;border-radius:0 4px 4px 0;background:#fff;color:#6c757d;font-size:18px;line-height:28px}
.dr-detail-search .dr-search-clear:disabled{opacity:.45;cursor:default}
.dr-grid-loading-area{position:relative;min-height:100px}.dr-grid-loading-overlay{position:absolute;inset:0;z-index:5;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.75)}.dr-group-loading{min-height:220px;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:5px;margin-bottom:10px}.dr-reference-spinner{display:block;width:60px;height:60px;box-sizing:border-box;border:8px solid #f3f3f3;border-bottom-color:#3498db;border-radius:50%;animation:dr-reference-spin 1s linear infinite}@keyframes dr-reference-spin{to{transform:rotate(360deg)}}
#dashboard-report-shell.dr-loading-groups{display:flex;flex-direction:column}#dashboard-report-shell.dr-loading-groups>.dr-filter-sticky{flex:0 0 auto}#dashboard-report-shell.dr-loading-groups>.dr-group-loading{flex:1 1 auto;min-height:120px;margin-bottom:0;background:transparent}
.dr-team-avatars{display:flex;align-items:center;gap:4px}.dr-team-avatar,.dr-team-more{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#eee6fa;color:#5928a5;font-size:10px;font-weight:600;border:1px solid #d8cce9}.dr-team-more{background:#edf2f5;color:#303a45}

#dr-details-grid .dr-description-column{width:170px;min-width:170px;max-width:170px;white-space:normal;overflow-wrap:anywhere}#dr-details-grid .dr-team-column{width:120px;min-width:120px;max-width:120px}#dr-details-grid .dr-name-column{white-space:normal;max-width:200px;overflow-wrap:anywhere}.dr-team-avatar,.dr-team-more{flex-shrink:0}
</style>
