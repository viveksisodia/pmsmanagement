        .ur-page{padding:12px 14px 20px;background:#f1f5f7;color:#202633;font-family:Arial,sans-serif}.ur-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.ur-title{font-size:13px;font-weight:600;color:#202633;line-height:16px;white-space:nowrap}.ur-back{color:#5928a5;text-decoration:none;font-size:12px}.ur-filters{display:flex;align-items:end;gap:9px;flex-wrap:wrap;padding:10px;background:#fff;border:1px solid #e7ebef;border-radius:5px;margin-bottom:10px}.ur-field{display:flex;flex-direction:column;gap:4px;font-size:10px;color:#59616a}.ur-field input,.ur-field select{height:30px;min-width:118px;padding:4px 7px;border:1px solid #d7dce2;border-radius:4px;background:#fff;color:#303a45;font-size:11px}.ur-button{height:30px;padding:0 12px;border:0;border-radius:4px;background:#5928a5;color:#fff;font-size:11px;cursor:pointer}.ur-button.secondary{background:#fff;color:#5928a5;border:1px solid #d8cce9}.ur-summary{display:grid;grid-template-columns:repeat(4,minmax(110px,1fr));gap:8px;margin-bottom:10px}.ur-stat{background:#fff;border:1px solid #edf0f2;border-radius:5px;padding:9px 11px}.ur-stat span{display:block;font-size:10px;color:#68717a}.ur-stat strong{display:block;margin-top:5px;font-size:16px;color:#19242f}.ur-card{background:#fff;border:1px solid #edf0f2;border-radius:5px;padding:10px;margin-bottom:10px}.ur-card h2{font-size:12px;margin:0 0 8px;color:#111}.ur-table-wrap{overflow:auto;max-height:55vh}.ur-table{border-collapse:collapse;width:100%;min-width:1050px;font-size:11px}.ur-table th{position:sticky;top:0;background:#edf2f5;z-index:1;font-weight:600;text-align:left}.ur-table td,.ur-table th{padding:6px 7px;border:1px solid #e4e9ed;white-space:nowrap}.ur-table td.wrap{white-space:normal;min-width:160px;max-width:260px}.ur-hours-table{min-width:950px}.ur-hours-table th{text-align:center}.ur-hours-table th:first-child,.ur-hours-table th:nth-child(2),.ur-hours-table td:first-child,.ur-hours-table td:nth-child(2){text-align:left}.ur-hours-table th small{display:block;font-size:10px;font-weight:400;color:#66717d;margin-top:3px}.ur-hours-table .ur-week-off{background:#e7e9ec;color:#606a74}.ur-hours-table .ur-hours-value{text-align:center}.ur-hours-table .ur-total-row th{background:#e9e3f3;font-weight:700}.ur-chip{display:inline-block;padding:2px 6px;border-radius:3px;background:#edf2f5}.ur-group-button{border:0;padding:2px 6px;border-radius:3px;background:#edf2f5;color:#202633;font:inherit;cursor:pointer}.ur-group-button:hover,.ur-group-button:focus{background:#dbe6ee;text-decoration:underline}.ur-filter-actions{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;align-self:stretch;gap:6px;margin-left:auto;min-width:140px}.ur-filter-action-buttons{display:flex;align-items:center;justify-content:flex-end;gap:8px}.ur-filter-title{font-size:12px;font-weight:600;color:#202633;line-height:16px;white-space:nowrap}.ur-export-button{width:34px;min-width:34px;padding:0;display:inline-flex;align-items:center;justify-content:center}.ur-export-button svg{width:17px;height:17px}.ur-muted{color:#7d8791}.ur-error{padding:10px;color:#a52828;background:#fff2f2;border:1px solid #f4cccc;border-radius:4px;font-size:11px}.ur-initial-loading{min-height:260px;display:flex;align-items:center;justify-content:center;gap:12px;color:#59616a;background:#f1f5f7;font-size:13px}.ur-initial-loading small{display:block;margin-top:4px;color:#7d8791;font-size:11px}.ur-loading{padding:30px 22px;text-align:center;color:#59616a;font-size:13px}.ur-spinner{display:inline-block;width:26px;height:26px;border:3px solid #ddd4eb;border-top-color:#5928a5;border-radius:50%;animation:ur-spin .8s linear infinite;vertical-align:middle}.ur-loading .ur-spinner{margin-bottom:10px}.ur-initial-loading .ur-spinner{flex:0 0 26px}@keyframes ur-spin{to{transform:rotate(360deg)}}.ur-empty{text-align:center!important;color:#84909b;padding:20px!important}.ur-grid-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:0}.ur-grid-footer .ur-field{flex-direction:row;align-items:center;gap:8px}.ur-grid-footer .ur-field select{min-width:70px}.ur-grid-footer .ur-pager{display:flex;align-items:center;gap:8px}.ur-grid-footer .ur-page-count{min-width:42px;text-align:center;color:#59616a;font-size:11px}.ur-issue-only[hidden]{display:none!important}@media(max-width:700px){.ur-summary{grid-template-columns:repeat(2,minmax(100px,1fr))}.ur-head{align-items:flex-start;flex-direction:column}.ur-filter-actions{margin-left:auto}.ur-grid-footer{align-items:flex-start;flex-direction:column}.ur-grid-footer .ur-pager{width:100%;justify-content:flex-end}}
    .ur-hours-table .ur-leave-full{background:#fde7e7;color:#8b3030}.ur-hours-table .ur-leave-half{background:#fff2cc;color:#755600}
    .ur-hours-tooltip-popup .tooltip-inner{white-space:pre;text-align:left;max-width:280px}
            /* Match the alignment of the final two columns in rows and totals. */
