<%@ Page Title="User Dashboard Reports" Language="C#" CodeFile="default.aspx.cs" Inherits="userdashboardreport" MasterPageFile="~/pms/angularmaster/angular_head.master" AutoEventWireup="true" %>
<asp:Content ID="ReportHead" ContentPlaceHolderID="head" Runat="Server">
    <style>
.ur-detail-search-right{display:flex;align-items:center;width:280px;max-width:100%}.ur-detail-search-right .ur-search-icon{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:1px solid #ced4da;border-right:0;border-radius:4px 0 0 4px;background:#f8f9fa;color:#6c757d}.ur-detail-search-right .ur-field{flex:1;min-width:0}.ur-detail-search-right input{height:32px;box-sizing:border-box;width:100%;min-width:0;border:1px solid #ced4da;border-radius:0 4px 4px 0;padding:4px 7px;font-size:12px}

.ur-details-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:8px}.ur-details-heading h2{margin:0}.ur-detail-search-right{margin-left:auto}.ur-detail-search-right input{width:260px;max-width:100%}

.ur-table tr.ur-selected-group>td{background:#eee6fa}.ur-table .ur-selected-group .ur-group-button{background:#5928a5;color:#fff;font-weight:600}

        .ur-page{padding:12px 14px 20px;background:#f1f5f7;color:#202633;font-family:Arial,sans-serif}.ur-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.ur-title{font-size:13px;font-weight:600;color:#202633;line-height:16px;white-space:nowrap}.ur-back{color:#5928a5;text-decoration:none;font-size:12px}.ur-filters{display:flex;align-items:end;gap:9px;flex-wrap:wrap;padding:10px;background:#fff;border:1px solid #e7ebef;border-radius:5px;margin-bottom:10px}.ur-field{display:flex;flex-direction:column;gap:4px;font-size:10px;color:#59616a}.ur-field input,.ur-field select{height:30px;min-width:118px;padding:4px 7px;border:1px solid #d7dce2;border-radius:4px;background:#fff;color:#303a45;font-size:11px}.ur-button{height:30px;padding:0 12px;border:0;border-radius:4px;background:#5928a5;color:#fff;font-size:11px;cursor:pointer}.ur-button.secondary{background:#fff;color:#5928a5;border:1px solid #d8cce9}.ur-summary{display:grid;grid-template-columns:repeat(4,minmax(110px,1fr));gap:8px;margin-bottom:10px}.ur-stat{background:#fff;border:1px solid #edf0f2;border-radius:5px;padding:9px 11px}.ur-stat span{display:block;font-size:10px;color:#68717a}.ur-stat strong{display:block;margin-top:5px;font-size:16px;color:#19242f}.ur-card{background:#fff;border:1px solid #edf0f2;border-radius:5px;padding:10px;margin-bottom:10px}.ur-card h2{font-size:12px;margin:0 0 8px;color:#111}.ur-table-wrap{overflow:auto;max-height:55vh}.ur-table{border-collapse:collapse;width:100%;min-width:1050px;font-size:11px}.ur-table th{position:sticky;top:0;background:#edf2f5;z-index:1;font-weight:600;text-align:left}.ur-table td,.ur-table th{padding:6px 7px;border:1px solid #e4e9ed;white-space:nowrap}.ur-table td.wrap{white-space:normal;min-width:160px;max-width:260px}.ur-hours-table{min-width:950px}.ur-hours-table th{text-align:center}.ur-hours-table th:first-child,.ur-hours-table th:nth-child(2),.ur-hours-table td:first-child,.ur-hours-table td:nth-child(2){text-align:left}.ur-hours-table th small{display:block;font-size:10px;font-weight:400;color:#66717d;margin-top:3px}.ur-hours-table .ur-week-off{background:#e7e9ec;color:#606a74}.ur-hours-table .ur-hours-value{text-align:center}.ur-hours-table .ur-total-row th{background:#e9e3f3;font-weight:700}.ur-chip{display:inline-block;padding:2px 6px;border-radius:3px;background:#edf2f5}.ur-group-button{border:0;padding:2px 6px;border-radius:3px;background:#edf2f5;color:#202633;font:inherit;cursor:pointer}.ur-group-button:hover,.ur-group-button:focus{background:#dbe6ee;text-decoration:underline}.ur-filter-actions{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;align-self:stretch;gap:6px;margin-left:auto;min-width:140px}.ur-filter-action-buttons{display:flex;align-items:center;justify-content:flex-end;gap:8px}.ur-filter-title{font-size:12px;font-weight:600;color:#202633;line-height:16px;white-space:nowrap}.ur-export-button{width:34px;min-width:34px;padding:0;display:inline-flex;align-items:center;justify-content:center}.ur-export-button svg{width:17px;height:17px}.ur-muted{color:#7d8791}.ur-error{padding:10px;color:#a52828;background:#fff2f2;border:1px solid #f4cccc;border-radius:4px;font-size:11px}.ur-initial-loading{min-height:260px;display:flex;align-items:center;justify-content:center;gap:12px;color:#59616a;background:#f1f5f7;font-size:13px}.ur-initial-loading small{display:block;margin-top:4px;color:#7d8791;font-size:11px}.ur-loading{padding:30px 22px;text-align:center;color:#59616a;font-size:13px}.ur-spinner{display:inline-block;width:26px;height:26px;border:3px solid #ddd4eb;border-top-color:#5928a5;border-radius:50%;animation:ur-spin .8s linear infinite;vertical-align:middle}.ur-loading .ur-spinner{margin-bottom:10px}.ur-initial-loading .ur-spinner{flex:0 0 26px}@keyframes ur-spin{to{transform:rotate(360deg)}}.ur-empty{text-align:center!important;color:#84909b;padding:20px!important}.ur-grid-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:0}.ur-grid-footer .ur-field{flex-direction:row;align-items:center;gap:8px}.ur-grid-footer .ur-field select{min-width:70px}.ur-grid-footer .ur-pager{display:flex;align-items:center;gap:8px}.ur-grid-footer .ur-page-count{min-width:42px;text-align:center;color:#59616a;font-size:11px}.ur-issue-only[hidden]{display:none!important}@media(max-width:700px){.ur-summary{grid-template-columns:repeat(2,minmax(100px,1fr))}.ur-head{align-items:flex-start;flex-direction:column}.ur-filter-actions{margin-left:auto}.ur-grid-footer{align-items:flex-start;flex-direction:column}.ur-grid-footer .ur-pager{width:100%;justify-content:flex-end}}
    .ur-hours-table .ur-leave-full{background:#fde7e7;color:#8b3030}.ur-hours-table .ur-leave-half{background:#fff2cc;color:#755600}
    .ur-hours-tooltip-popup .tooltip-inner{white-space:pre;text-align:left;max-width:280px}
            /* Match the alignment of the final two columns in rows and totals. */
        .ur-hours-table td:nth-last-child(-n+2),
        .ur-hours-table th:nth-last-child(-n+2){text-align:right;vertical-align:middle;font-variant-numeric:tabular-nums;padding-right:12px}
        #user-report-shell{overflow:auto;box-sizing:border-box;background:#f1f5f7;isolation:isolate;z-index:1}
        #user-report-shell .ur-fixed-filters{position:sticky;top:0;z-index:20;background:#fff;box-shadow:0 2px 4px #0001}
        #user-report-shell .ur-details-heading{align-items:center}
        #user-report-shell .ur-detail-search-right{flex:0 1 280px;width:280px;margin-left:auto;gap:0}
        #user-report-shell .ur-detail-search-right .ur-field{margin:0;display:block;min-width:0;flex:1}
        #user-report-shell .ur-detail-search-right input{width:100%;max-width:100%;min-width:0;height:32px;margin:0;box-sizing:border-box}
        #user-report-shell .ur-search-icon{flex:0 0 32px;box-sizing:border-box}
    </style>
    <script src="app/userreport.service.js"></script>
    <script src="app/userreport.main.js?v=8"></script>
</asp:Content>
<asp:Content ID="ReportContent" ContentPlaceHolderID="ContentPlaceHolder1" Runat="Server">
    <div id="urInitialLoading" class="ur-initial-loading" role="status" aria-live="polite"><span class="ur-spinner" aria-hidden="true"></span><span>Loading report<small>Preparing your dashboard data…</small></span></div>
    <div id="user-report-shell" class="ur-page" ng-app="pmsUserReportApp" ng-controller="UserReportController as vm" ng-cloak>
        <div class="ur-head"><span class="ur-muted">Dashboard detail report</span><a class="ur-back" href="/pms/userdashboard/">← Back to Dashboard</a></div>
        <div class="ur-filters ur-fixed-filters">
            <label class="ur-field">Date range<select ng-model="vm.filterType" ng-options="item for item in vm.filterOptions" ng-change="vm.onFilterChange()"></select></label>
            <label class="ur-field" ng-show="vm.filterType === 'Custom Range'">From date<input type="date" ng-model="vm.fromDate" ng-change="vm.load()" /></label>
            <label class="ur-field" ng-show="vm.filterType === 'Custom Range'">To date<input type="date" ng-model="vm.toDate" ng-change="vm.load()" /></label>
            <label class="ur-field" ng-show="!vm.isIssues">Priority<select ng-model="vm.taskPriority" ng-options="item.value as item.label for item in vm.taskPriorityOptions" ng-change="vm.isHours ? vm.applyHoursFilters() : vm.applyTaskFilters(true)"></select></label>
            <label class="ur-field" ng-show="!vm.isIssues">Status<select ng-model="vm.taskStatus" ng-options="item.value as item.label for item in vm.taskStatusOptions" ng-change="vm.isHours ? vm.applyHoursFilters() : vm.applyTaskFilters(true)"></select></label>
            <label class="ur-field" ng-show="vm.isIssues">Type<select ng-model="vm.issueEntityType" ng-options="item.value as item.label for item in vm.issueEntityOptions" ng-change="vm.load()"></select></label>
            <label class="ur-field" ng-show="vm.isIssues">Priority<select ng-model="vm.issuePriority" ng-options="item.value as item.label for item in vm.issuePriorityOptions" ng-change="vm.applyGridSearch()"></select></label>
            
            <label class="ur-field" ng-show="vm.isIssues">Status<select ng-model="vm.issueStatus" ng-options="item.value as item.label for item in vm.issueStatusOptions" ng-change="vm.load()"></select></label>
            
            <div class="ur-filter-actions">
                <div class="ur-filter-title">{{vm.title}}</div>
                <div class="ur-filter-action-buttons">
                    <button type="button" class="ur-button secondary" ng-show="vm.isIssues" ng-click="vm.clearIssueFilters()">Clear Filters</button>
                    <button type="button" class="ur-button secondary" ng-show="!vm.isIssues && !vm.isHours" ng-click="vm.clearTaskFilters()">Clear Task Filters</button>
                    <button type="button" class="ur-button secondary ur-export-button" ng-click="vm.exportExcel()" ng-disabled="vm.exportLoading || vm.loading || vm.detailLoading || (vm.isGrouped ? !vm.summary.total : !vm.rows.length)" aria-label="Export to Excel" title="Export to Excel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2.75h8l4.25 4.3v13.2H6z" fill="#eaf6ee" stroke="#16834b" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 2.75v4.5h4.25" fill="none" stroke="#16834b" stroke-width="1.5" stroke-linejoin="round"/><path d="m9 11 4 6m0-6-4 6" fill="none" stroke="#16834b" stroke-width="1.8" stroke-linecap="round"/></svg></button>
                </div>
            </div>
        </div>
        <div class="ur-error" ng-if="vm.error">{{vm.error}}</div>
        <div class="ur-loading" ng-if="vm.loading"><span class="ur-spinner" aria-hidden="true"></span><div>Loading report data…</div><span class="ur-muted">Please wait while we prepare the report.</span></div>
        <div ng-if="!vm.loading && !vm.error">
            <div class="ur-summary" ng-if="vm.isEfficiencyReport">
                <div class="ur-stat"><span>{{vm.isIssues ? 'Total issues' : 'Tasks in report'}}</span><strong>{{vm.summary.total}}</strong></div>
                <div class="ur-stat"><span>{{vm.isIssues ? 'Resolved issues' : 'Completed tasks'}}</span><strong>{{vm.summary.completed}}</strong></div>
                <div class="ur-stat"><span>Task completion</span><strong>{{vm.summary.completion}}%</strong></div>
                <div class="ur-stat" ng-if="vm.isTimeEfficiency"><span>Average time efficiency</span><strong>{{vm.summary.timeEfficiency.toFixed(1)}}%</strong></div>
            </div>
            <section class="ur-card" ng-if="!vm.isIssues && !vm.isHours"><h2>Grouped by {{vm.groupLabel}}</h2><div class="ur-table-wrap"><table class="ur-table"><thead><tr><th>{{vm.groupLabel}}</th><th>Count</th><th>Assigned Time</th><th>Spent Time</th><th ng-if="vm.isEfficiencyReport">Efficiency</th></tr></thead><tbody><tr ng-repeat="group in vm.groups" ng-class="{'ur-selected-group':vm.selectedGroupName !== null && vm.selectedGroupName === group.name}"><td><button type="button" class="ur-group-button" ng-click="vm.openGroup(group.name)" aria-pressed="{{vm.selectedGroupName !== null && vm.selectedGroupName === group.name}}" title="View {{group.name}} tasks">{{group.name}}</button></td><td>{{group.count}}</td><td>{{group.assignedText}}</td><td>{{group.spentText}}</td><td ng-if="vm.isEfficiencyReport">{{group.efficiencyText}}</td></tr><tr ng-if="!vm.groups.length"><td colspan="{{vm.isEfficiencyReport ? 5 : 4}}" class="ur-empty">No data in this date range</td></tr></tbody></table></div></section>
            <section class="ur-card" ng-if="vm.isHours"><h2>Task Hours</h2><div style="font-size:11px;margin-bottom:8px"><span style="background:#fde7e7;color:#8b3030;padding:3px 7px">Approved Full-Day Leave</span> <span style="background:#fff2cc;color:#755600;padding:3px 7px">Approved Half-Day Leave</span></div><div class="ur-table-wrap"><table class="ur-table ur-hours-table"><thead><tr><th>Task</th><th>Project Name</th><th ng-repeat="day in vm.days" ng-class="{'ur-week-off':day.isWeekOff || day.isHoliday,'ur-leave-full':day.leaveLabel && day.leaveLabel.indexOf('Full Day') === 0,'ur-leave-half':day.leaveLabel && day.leaveLabel.indexOf('Full Day') !== 0}" ur-hours-tooltip="{{vm.hoursDayTooltip($index)}}"><span ng-if="day.isWeekOff">Week Off</span><span ng-if="!day.isWeekOff && day.isHoliday">Holiday</span><span ng-if="!day.isWeekOff && !day.isHoliday">{{day.weekday}}</span><small>{{day.dateLabel}}</small></th><th>Assigned Time</th><th>Actual Time</th></tr></thead><tbody><tr ng-repeat="row in vm.pageRows()"><td>{{row.taskName}}</td><td>{{row.projectName}}</td><td class="ur-hours-value" ng-repeat="value in row.dailyActual track by $index" ng-class="{'ur-leave-full':vm.days[$index].leaveLabel && vm.days[$index].leaveLabel.indexOf('Full Day') === 0,'ur-leave-half':vm.days[$index].leaveLabel && vm.days[$index].leaveLabel.indexOf('Full Day') !== 0}" ur-hours-tooltip="{{vm.hoursDayTooltip($index)}}">{{value}}</td><td>{{row.assignedText}}</td><td>{{row.actualText}}</td></tr><tr ng-if="!vm.rows.length"><td class="ur-empty" colspan="{{vm.days.length + 4}}">No task hours in this date range</td></tr><tr class="ur-total-row" ng-if="vm.days.length"><th colspan="2">Total Day Hours</th><th class="ur-hours-value" ng-repeat="total in vm.dailyTotals track by $index" ng-class="{'ur-leave-full':vm.days[$index].leaveLabel && vm.days[$index].leaveLabel.indexOf('Full Day') === 0,'ur-leave-half':vm.days[$index].leaveLabel && vm.days[$index].leaveLabel.indexOf('Full Day') !== 0}" ur-hours-tooltip="{{vm.hoursDayTooltip($index)}}">{{total}}</th><th>{{vm.assignedTotalText}}</th><th>{{vm.actualTotalText}}</th></tr></tbody></table></div></section>
            <div class="ur-error" ng-if="vm.isGrouped && vm.selectedGroupName === null && vm.detailError">{{vm.detailError}}</div>
            <section class="ur-card" ng-if="!vm.isHours && (vm.isIssues || vm.selectedGroupName !== null)"><div class="ur-details-heading"><h2>{{vm.isIssues ? 'Issue details' : 'Task details - ' + vm.selectedGroupName}} <button type="button" class="ur-button secondary" ng-if="!vm.isIssues" ng-click="vm.clearGroup()">Back to groups</button></h2><div class="ur-detail-search-right" role="search"><span class="ur-search-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></span><label class="ur-field" ng-if="!vm.isIssues"><input aria-label="Search group details" type="search" ng-model="vm.searchText" ng-change="vm.applyGridSearch()" placeholder="Search group details..." /></label><label class="ur-field" ng-if="vm.isIssues"><input aria-label="Search issue details" type="search" ng-model="vm.issueSearch" ng-change="vm.applyGridSearch()" placeholder="Search issue details..." /></label></div></div><div class="ur-loading" ng-if="vm.detailLoading">Loading group details...</div><div class="ur-error" ng-if="vm.detailError">{{vm.detailError}}</div><div class="ur-table-wrap" ng-show="!vm.detailLoading"><table class="ur-table"><thead><tr ng-if="!vm.isIssues"><th>Project Name</th><th>Task</th><th>Description</th><th>Priority</th><th>Status</th><th>Total Completion</th><th>Assigned Time</th><th>Spent Time</th><th ng-if="vm.isEfficiencyReport">Efficiency</th><th>Tags</th><th>Start Date</th><th>End Date</th></tr><tr ng-if="vm.isIssues"><th>#</th><th>Sr. No.</th><th>Type</th><th>Issue</th><th>Owner</th><th>Team</th><th>Status</th><th>Priority</th><th>Assign To</th><th>Create Date</th><th>Target Date</th><th>Issue Type</th><th>Project</th><th>Milestone</th></tr></thead><tbody><tr ng-repeat="row in vm.pageRows()" ng-if="!vm.isIssues"><td>{{row.projectName}}</td><td>{{row.taskName}}</td><td class="wrap">{{row.description}}</td><td>{{row.priority}}</td><td>{{row.status}}</td><td>{{row.completion}}%</td><td>{{row.assignedText}}</td><td>{{row.spentText}}</td><td ng-if="vm.isEfficiencyReport">{{vm.efficiencyDisplay(row)}}</td><td class="wrap">{{row.tags}}</td><td>{{row.startDate}}</td><td>{{row.endDate}}</td></tr><tr ng-repeat="row in vm.pageRows()" ng-if="vm.isIssues"><td>{{$index + 1 + ((vm.currentPage - 1) * vm.pageSize)}}</td><td>{{row.serialNo}}</td><td><span class="ur-chip">{{row.entityType}}</span></td><td>{{row.issueName}}</td><td>{{row.owner}}</td><td>{{row.team}}</td><td><span class="ur-chip" ng-style="{'background-color':row.statusColor || '#eef2f7','color':'#000'}">{{row.status}}</span></td><td>{{row.priority}}</td><td>{{row.assignTo}}</td><td>{{row.createDate}}</td><td>{{row.targetDate}}</td><td>{{row.issueType}}</td><td>{{row.projectName}}</td><td>{{row.milestoneName}}</td></tr><tr ng-if="!vm.visibleRows().length"><td colspan="{{vm.isIssues ? 14 : (vm.isEfficiencyReport ? 12 : 11)}}" class="ur-empty">No records found for this group and filters</td></tr></tbody></table></div></section>
        </div>
        <div class="ur-filters ur-grid-footer" ng-if="!vm.loading && !vm.error && vm.visibleRows().length && (vm.isIssues || vm.isHours || vm.selectedGroupName !== null)">
            <label class="ur-field">Records per page<select ng-model="vm.pageSize" ng-options="size for size in [5,10,20,50,100]" ng-change="vm.setPageSize()" ng-disabled="vm.detailLoading"></select></label>
            <span class="ur-muted">Showing {{vm.pageStart}}-{{vm.pageEnd}} of {{vm.isGrouped ? vm.totalRows : vm.visibleRows().length}}</span>
            <div class="ur-pager"><button type="button" class="ur-button secondary" ng-click="vm.previousPage()" ng-disabled="vm.detailLoading || vm.currentPage <= 1">Previous</button>
            <strong class="ur-page-count">{{vm.currentPage}} / {{vm.pageCount}}</strong>
            <button type="button" class="ur-button secondary" ng-click="vm.nextPage()" ng-disabled="vm.detailLoading || vm.currentPage >= vm.pageCount">Next</button></div>
        </div>
    </div>
</asp:Content>
