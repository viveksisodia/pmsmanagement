        .issues-table td.issue-color-cell{position:relative;padding:0!important;color:#000!important;text-align:center;min-width:105px}.issue-color-cell .issue-cell-choice{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;width:100%;height:100%;margin:0;border:0;border-radius:0;background:transparent!important;color:#000!important;font-weight:700!important;line-height:1.2;padding:5px 8px;box-sizing:border-box}.issue-color-cell .issue-cell-choice:disabled{color:#000!important;opacity:1;-webkit-text-fill-color:#000}.issue-choice-menu button{color:#000}
        .issue-person-trigger{display:flex;align-items:center;gap:5px;width:100%;border:0;background:transparent;padding:0;color:#111;font-size:12px;text-align:left;cursor:pointer;min-height:26px;white-space:nowrap}.issue-person-trigger:disabled{color:#111;opacity:1;cursor:default}.issue-person-arrow{margin-left:auto;font-size:10px;color:#8298b0}.issue-person-menu{position:fixed;z-index:9998;width:260px;border-radius:5px;background:white;box-shadow:0 5px 16px rgba(0,0,0,.18);padding:8px}.issue-person-menu>input{width:100%;border:0;border-bottom:1px solid #e4e9ef;padding:8px 2px;margin-bottom:6px;outline:none;font-size:12px}.issue-person-options{max-height:210px;overflow:auto}.issue-person-options>button{display:block;width:100%;border:0;background:white;color:#3478df;font-size:12px;padding:8px 12px;text-align:left;cursor:pointer}.issue-person-options>button:hover,.issue-person-options>button.active{background:#edf2f8;color:#111}.issue-person-options>button.selected{font-weight:600;color:#111}
