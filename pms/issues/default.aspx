<asp:Content ID="IssuesContent" ContentPlaceHolderID="ContentPlaceHolder1" Runat="Server">
    <div class="issues-page" ng-app="pmsIssuesApp" ng-controller="IssuesController" ng-cloak ng-click="closeEmployeeMenu($event);closeRowMenu();closeCellChoice();closePersonChoice()">
        <div class="issues-card">
            <div class="issues-titlebar">
                <h3 class="issues-title">Issues List</h3>
                <span class="issues-mode">{{isadmin==1 ? 'Admin - All Issues' : 'My Issues'}}</span>
            </div>
            <div class="issues-filterbar">
                <select aria-label="Filter by date" ng-model="filter.DateFilter" ng-options="x.Id as x.Name for x in dateFilters" ng-change="dateFilterChanged()"></select>
                <div class="issues-employee">
                    <div class="issues-employee-trigger" role="combobox" tabindex="0" ng-click="openEmployeeMenu($event)" ng-keydown="($event.keyCode===13 || $event.keyCode===32) && openEmployeeMenu($event)" aria-haspopup="listbox" aria-expanded="{{employeeMenuOpen}}" aria-label="Filter by employee">
                        <span class="issues-employee-trigger-content">
                            <span class="issues-employee-chip" ng-repeat="employee in getSelectedEmployees() track by employee.Id" ng-click="$event.stopPropagation()">
                                <span>{{employee.Name}}</span><button type="button" aria-label="Remove {{employee.Name}}" ng-click="unselectEmployee(employee.Id,$event)">&times;</button>
                            </span>
                            <input id="employeeSearchInput" type="search" class="issues-employee-inline-search" ng-model="employeeSearch" ng-change="resetEmployeeActiveIndex()" ng-keydown="employeeSearchKeydown($event)" placeholder="Search employees..." autocomplete="off" aria-label="Search employees" ng-click="$event.stopPropagation();openEmployeeMenu($event)" ng-focus="openEmployeeMenu($event)" />
                        </span><span class="issues-employee-trigger-arrow" aria-hidden="true">&#9662;</span>
                    </div>
                    <div class="issues-employee-popup" ng-if="employeeMenuOpen" ng-click="$event.stopPropagation()">
                        <div class="issues-employee-error" ng-if="employeeError">{{employeeError}}</div>
                        <div class="issues-employee-options" ng-if="!employeeError">
                            <button type="button" role="option" id="employee-option-{{$index}}" class="issues-employee-option" ng-class="{'active':$index===employeeActiveIndex}" ng-repeat="employee in getFilteredEmployeeOptions() track by employee.Id" ng-click="toggleEmployee(employee.Id,$event)">
                                <span>{{employee.Name}}</span>
                            </button>
                            <div class="issues-employee-empty" ng-if="!getFilteredEmployeeOptions().length">{{selectedEmployeeIds.length === employeeOptions.length && employeeOptions.length ? 'All employees selected' : 'No matching employees'}}</div>
                        </div>
                        <div class="issues-employee-footer"><button type="button" class="issues-btn issues-btn-light" ng-click="clearEmployeeFilter()">Clear</button><button type="button" class="issues-btn" style="background:#7b0b69;color:#fff" ng-click="applyEmployeeFilter()">Apply</button></div>
                    </div>
                </div>
                <select aria-label="Filter by issue hierarchy type" ng-model="filter.EntityType" ng-options="x.Id as x.Name for x in entityTypes" ng-change="filterChanged()"></select>
                
                
                <select aria-label="Filter by issue status" ng-model="filter.IssueStatus" ng-options="x.Id as x.Name for x in issueStatusFilters" ng-change="filterChanged()"></select>
                
                <div class="issues-actions-top"><button type="button" class="issues-btn issues-btn-light" ng-click="clearFilters()" ng-disabled="loading">Clear Filters</button></div>
            </div>
            <div class="issues-custom-date" ng-if="filter.DateFilter=='CUSTOM'" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid #eceef1;background:#fcfcfd">
                <label style="margin:0;font-size:11px;color:#707782">From</label><input type="date" ng-model="filter.FromDate" />
                <label style="margin:0;font-size:11px;color:#707782">To</label><input type="date" ng-model="filter.ToDate" />
                <button type="button" class="issues-btn" style="background:#7b0b69;color:#fff" ng-click="filterChanged()">Apply</button>
            </div>
            <div class="issues-alert" ng-if="error">{{error}}</div>
            <div class="issues-gridsearch">
                <input type="search" ng-model="searchText" placeholder="Search issues on this page..." autocomplete="off" aria-label="Search issues" />
                <span class="issues-count" ng-if="totalRows>0">{{filteredRows.length}} visible / {{totalRows}} issues</span>
                <button type="button" class="issues-btn issues-btn-light" ng-click="searchText=''" ng-disabled="!searchText">Clear Search</button>
            </div>
            <div class="issues-tablewrap" ng-class="{'refreshing':loading && rows.length>0}" aria-busy="{{loading}}">
                <div class="issues-refreshline" ng-if="loading && rows.length>0"><span></span></div>
                <table class="issues-table">
                    <thead><tr><th>#</th><th>Sr. No.</th><th>Type</th><th>Issue</th><th>Owner</th><th>Team</th><th>Status</th><th>Priority</th><th>Assign To</th><th>Create Date</th><th>Target Date</th><th>Issue Type</th><th>Project</th><th>Milestone</th><th class="issue-actions-heading" aria-label="Actions"></th></tr></thead>
                    <tbody>
                        <tr ng-if="loading && rows.length==0"><td colspan="15" class="issues-empty"><span class="issues-loading"><span class="issues-spinner"></span> Loading issues...</span></td></tr>
                        <tr ng-repeat="row in filteredRows track by row.Id">
                            <td>{{((currentPage-1)*pageSize)+$index+1}}</td><td>{{row.HierarchySrNo || '-'}}</td>
                            <td><span class="issues-type" ng-class="entityClass(row.EntityType)">{{row.EntityType}}</span></td>
                            <td class="issues-name" title="{{row.Description}}">{{row.IssueName || ('Issue #'+row.Id)}}</td><td><button type="button" class="issue-person-trigger" ng-class="{'issue-person-avatar-trigger':people(row,'Owner').length}" ng-click="openPersonChoice(row,'Owner',$event)" ng-disabled="saving || loading || !permissions.ChangeOwner" aria-haspopup="listbox" aria-label="Change owner" aria-expanded="{{personChoice && personChoice.Row.Id===row.Id && personChoice.Field==='Owner'}}"><span class="issue-avatar" ng-repeat="person in people(row,'Owner') track by person.Id" ng-style="{'background-color':avatarColor(person.Id)}" ng-mouseenter="showIssueTooltip(person.Name,$event)" ng-mouseleave="hideIssueTooltip()">{{initials(person.Name)}}</span><span ng-if="!people(row,'Owner').length">Select owner</span><span ng-if="!people(row,'Owner').length" class="issue-person-arrow" aria-hidden="true">&#9662;</span></button></td><td><div class="issue-team-cell"><div class="issue-avatars issue-team-avatars"><span class="issue-team-person" ng-repeat="person in people(row,'Team').slice(0,3) track by person.Id" ng-mouseenter="showIssueTooltip(person.Name,$event)" ng-mouseleave="hideIssueTooltip()"><span class="issue-avatar" ng-style="{'background-color':avatarColor(person.Id)}" aria-label="{{person.Name}}">{{initials(person.Name)}}</span><button type="button" class="issue-avatar-remove" ng-if="permissions.Edit" ng-click="removeIssueMember(row,person,$event)" ng-disabled="saving || loading" aria-label="Remove {{person.Name}} from issue team">&times;</button></span><span ng-if="people(row,'Team').length>3" ng-mouseenter="showIssueTooltip(remainingTeamNames(row),$event)" ng-mouseleave="hideIssueTooltip()">+{{people(row,'Team').length-3}}</span><span ng-if="!people(row,'Team').length">-</span></div><button type="button" class="issue-plus" ng-mouseenter="showIssueTooltip('+ Add Team',$event)" ng-mouseleave="hideIssueTooltip()" ng-if="permissions.Edit" ng-click="openEditor(row,'Team')" ng-disabled="saving || loading">+</button></div></td><td class="issue-color-cell" ng-style="statusStyle(row)"><button type="button" class="issue-cell-choice" aria-label="Change issue status" aria-haspopup="listbox" aria-expanded="{{cellChoice && cellChoice.Row.Id===row.Id && cellChoice.Field==='Status'}}" ng-click="openCellChoice(row,'Status',$event)" ng-disabled="saving || loading || !permissions.Edit || !statusOptions.length">{{row.StatusName || '-'}}</button></td>
<td class="issue-color-cell" ng-style="priorityStyle(row)">
    <button type="button" class="issue-cell-choice" aria-label="Change priority" aria-haspopup="listbox" aria-expanded="{{cellChoice && cellChoice.Row.Id===row.Id && cellChoice.Field==='Priority'}}" ng-click="openCellChoice(row,'Priority',$event)" ng-disabled="saving || loading || !permissions.Edit || !priorityOptions.length">{{row.PriorityName || '-'}}</button></td>
<td><button type="button" class="issue-person-trigger" ng-class="{'issue-person-avatar-trigger':people(row,'AssignTo').length}" ng-click="openPersonChoice(row,'AssignTo',$event)" ng-disabled="saving || loading || !permissions.Assign" aria-haspopup="listbox" aria-label="Change assigned employee" aria-expanded="{{personChoice && personChoice.Row.Id===row.Id && personChoice.Field==='AssignTo'}}"><span class="issue-avatar" ng-repeat="person in people(row,'AssignTo') track by person.Id" ng-style="{'background-color':avatarColor(person.Id)}" ng-mouseenter="showIssueTooltip(person.Name,$event)" ng-mouseleave="hideIssueTooltip()">{{initials(person.Name)}}</span><span ng-if="!people(row,'AssignTo').length">Select assignee</span><span ng-if="!people(row,'AssignTo').length" class="issue-person-arrow" aria-hidden="true">&#9662;</span></button></td>
<td>{{row.CreateDate || '-'}}</td><td>{{row.TargetDate || '-'}}</td><td>{{row.IssueTypeName || '-'}}</td><td>{{row.ProjectName || '-'}}</td><td>{{row.MilestoneName || '-'}}</td>
<td class="issue-actions-cell"><button type="button" class="issue-dots" ng-if="permissions.Edit || permissions.Delete" ng-click="toggleRowMenu(row,$event)" ng-disabled="saving || loading" aria-label="Issue actions" aria-haspopup="menu" aria-expanded="{{rowMenu && rowMenu.Id===row.Id}}">&#8942;</button></td>
                        </tr>
                        <tr ng-if="!loading && totalRows==0"><td colspan="15" class="issues-empty">No issues found for the selected filters.</td></tr>
                        <tr ng-if="!loading && totalRows>0 && filteredRows.length==0"><td colspan="15" class="issues-empty">No issues match your search on this page.</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="issues-paging" ng-if="totalRows>0">
                <div style="display:flex;align-items:center;gap:7px"><select ng-model="pageSize" ng-options="size for size in pageSizeOptions" ng-change="changePageSize()"></select><span>Records per page</span><span>{{startRow}}-{{endRow}} of {{totalRows}}</span></div>
                <div class="issues-pagebuttons"><button type="button" class="issues-pagebutton" ng-click="goToPage(currentPage-1)" ng-disabled="currentPage==1">Previous</button><button type="button" class="issues-pagebutton" ng-repeat="pageNo in pageNumbers track by pageNo" ng-class="{'active':pageNo==currentPage}" ng-click="goToPage(pageNo)">{{pageNo}}</button><button type="button" class="issues-pagebutton" ng-click="goToPage(currentPage+1)" ng-disabled="currentPage==totalPages">Next</button></div>
            </div>
        </div>

        <div class="issue-person-menu" ng-if="personChoice" ng-style="personChoiceStyle" issue-employee-keys="personChoiceKeydown($event)" ng-click="$event.stopPropagation()">
            <input id="issuePersonSearch" type="search" placeholder="Search..." ng-model="personChoice.Search" ng-change="personSearchChanged()" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="issuePersonOptions" aria-activedescendant="{{personChoice.Index>=0 ? 'issue-person-option-'+personChoice.Index : ''}}" />
            <div class="issue-person-options" id="issuePersonOptions" role="listbox" aria-label="Select employee"><button type="button" role="option" id="issue-person-option-{{$index}}" ng-repeat="person in personChoiceOptions() track by person.Id" ng-class="{'issue-person-keyboard-active':$index===personChoice.Index,'selected':person.Id===personSelectedId()}" ng-style="$index===personChoice.Index ? {'background-color':'#edf2f8','color':'#111','font-weight':'400'} : {}" aria-selected="{{person.Id===personSelectedId()}}" ng-click="selectPersonChoice(person)">{{person.Name}}</button><div class="issues-employee-empty" ng-if="!personChoiceOptions().length">No matching employees</div></div>
        </div>
        <div class="issue-choice-menu" ng-if="cellChoice" ng-style="cellChoiceStyle" role="listbox" tabindex="0" ng-keydown="choiceKeydown($event)" aria-label="{{cellChoice.Field}}" ng-click="$event.stopPropagation()">
            <button type="button" role="option" ng-repeat="option in cellChoice.Options track by option.Id" ng-class="{'active':$index===choiceIndex}" aria-selected="{{option.Id===(cellChoice.Field==='Status' ? cellChoice.Row.StatusId : cellChoice.Row.PriorityId)}}" ng-click="selectCellChoice(option)"><span class="issue-choice-dot" ng-style="{'background-color':choiceColor(option,cellChoice.Field)}"></span>{{option.Name}}</button>
        </div>
        <div class="issue-hover-tooltip" role="tooltip" ng-if="issueTooltip" ng-style="issueTooltipStyle">{{issueTooltip}}</div>
        <div class="issue-row-menu" ng-if="rowMenu" ng-style="rowMenuStyle" role="menu" ng-click="$event.stopPropagation()">
            <button type="button" role="menuitem" ng-if="permissions.Edit" ng-click="editFromMenu()"><span aria-hidden="true">&#9998;</span> Edit Issue</button>
            <button type="button" role="menuitem" class="issue-delete-action" ng-if="permissions.Delete" ng-click="deleteFromMenu()"><span aria-hidden="true">&#128465;</span> Delete Issue</button>
        </div>
        <div class="issue-modal-backdrop" ng-if="editor" ng-click="$event.stopPropagation()">
            <div class="issue-modal" role="dialog" aria-modal="true" aria-label="Edit issue">
                <h3>{{editor.Field==='Team' ? 'Add teams' : 'Edit Issue'}}</h3>
                <div class="issues-alert" ng-if="editError">{{editError}}</div>
                <div ng-if="editor.Field==='Edit'">
                    <label>Issue name</label><input ng-model="editor.IssueName" ng-disabled="saving" />
                    <label>Description</label><textarea rows="3" ng-model="editor.Description" ng-disabled="saving"></textarea>
                    <label>Status</label><select ng-model="editor.StatusId" ng-options="s.Id as s.Name for s in statusOptions" ng-disabled="saving"></select>
                    <label>Priority</label><select ng-model="editor.PriorityId" ng-options="p.Id as p.Name for p in priorityOptions" ng-disabled="saving"></select>
                    <label>Owner</label><select ng-model="editor.OwnerId" ng-options="e.Id as e.Name for e in editEmployees()" ng-disabled="saving || !permissions.ChangeOwner"><option value="">No owner</option></select>
                    <label>Assign To</label><select ng-model="editor.AssignToId" ng-options="e.Id as e.Name for e in assignOptions(editor)" ng-disabled="saving || !permissions.Assign"><option value="">Unassigned</option></select>
                </div>
                <label>Issue team</label><div class="issue-selected-team"><span class="issue-member-chip" ng-repeat="person in selectedEditTeam() track by person.Id">{{person.Name}}<button type="button" ng-click="toggleIssueTeam(person.Id)" ng-disabled="saving" aria-label="Remove {{person.Name}}">&times;</button></span></div><input type="search" placeholder="Select teams..." ng-model="editor.TeamSearch" ng-change="editor.TeamIndex=-1" issue-employee-keys="teamChoiceKeydown($event)" />
                <div class="issue-team-options" ng-if="editor.TeamSearch && editor.TeamSearch.trim()" id="issueTeamOptions" role="listbox" aria-label="Available team members"><button type="button" id="issue-team-option-{{$index}}" class="issue-team-option" ng-class="{'issue-team-keyboard-active':$index===editor.TeamIndex}" ng-style="$index===editor.TeamIndex ? {'background-color':'#edf2f8','color':'#111','font-weight':'400'} : {}" ng-repeat="person in filteredEditEmployees() track by person.Id" ng-click="toggleIssueTeam(person.Id)" ng-disabled="saving"><span class="issue-avatar" ng-style="{'background-color':avatarColor(person.Id)}">{{initials(person.Name)}}</span>{{person.Name}}</button><div class="issues-employee-empty" ng-if="!filteredEditEmployees().length">No available matching employees</div></div>
                <div class="issue-modal-footer"><button type="button" class="issues-btn issues-btn-light" ng-click="closeEditor()" ng-disabled="saving">{{editor.Field==='Team' ? 'Close' : 'Cancel'}}</button><button type="button" class="issues-btn" style="background:#7b0b69;color:white" ng-if="editor.Field!=='Team'" ng-click="saveEditor()" ng-disabled="saving || (editor.Field==='Edit' && (!statusOptions.length || !priorityOptions.length))">{{saving ? 'Saving...' : 'Save'}}</button></div>
            </div>
        </div>
    </div>
</asp:Content>
