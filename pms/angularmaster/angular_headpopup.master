<script>
    var count11 = 1;
    function loadsrc(val1, val2) {
        count11++;
        //alert(val1);
        if (val2.includes("aspx?"))
        {
          document.getElementById(val1).src = val2 + "&count=" + count11;
        }
        else
        {
             document.getElementById(val1).src = val2 + "?count=" + count11;
        }
       
        try {

            //document.getElementById("").innerHTML = val3;
        }
        catch (ex) {
        }
    }
function loadsrc_angold(val1, val2) {
        count11++;
        //alert(val1);
        document.getElementById(val1).src="";            
        
       
        try {
document.getElementById(val1).src = val2;
            //document.getElementById("").innerHTML = val3;
        }
        catch (ex) {
        }
    }
function loadsrc_ang(frameId, url) {

    let frame = document.getElementById(frameId);

    if (frame) {
        frame.src = "about:blank";   // force reset

        setTimeout(function () {
            frame.src = url + "&r=" + Date.now();
        }, 50);
    }
}
</script>
