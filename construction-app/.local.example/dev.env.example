# Copy this file to construction-app\.local\dev.env and fill in the values.
# The .local folder is git-ignored. Never commit real values.

# At least 32 random characters, used to sign access tokens.
Jwt__SigningKey=

# Connection string to the database that holds the cpm_ objects.
# Development: a LocalDB scratch database whose name starts with cpmtest_ (allowed by the script guard).
# Real use: absolutebook_2172, with a login that can only EXECUTE the cpm_ procedures.
ConstructionDb__ConnectionString=Server=(localdb)\MSSQLLocalDB;Database=cpmtest_scratch;Trusted_Connection=True;TrustServerCertificate=True

# Used only by tests/api-smoke.mjs against a test database.
TEST_ADMIN_USER=demoadmin
TEST_ADMIN_PASSWORD=
TEST_VIEWER_USER=viewer1
TEST_VIEWER_PASSWORD=
